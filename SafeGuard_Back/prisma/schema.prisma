generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- TABLAS ----------------

model Usuario {
  id           String       @id @default(uuid())
  nombre       String
  email        String       @unique
  passwordHash String
  rol          String       // 'Administrativo', 'Contratante', 'Vigilante'
  
  // Relaciones (Un usuario puede tener muchas solicitudes o turnos)
  solicitudes  Solicitud[]  // Si es Contratante
  turnos       Turno[]      // Si es Vigilante
  createdAt    DateTime     @default(now())
}

model Solicitud {
  id         String   @id @default(uuid())
  ubicacion  String
  latitud    Float    // <-- NUEVO: Para saber exactamente dónde es
  longitud   Float    // <-- NUEVO
  horaInicio DateTime
  horaFin    DateTime // <-- NUEVO: Para saber a qué hora termina el servicio
  estado     String   @default("Pendiente") 
  
  clienteId  String
  cliente    Usuario  @relation(fields: [clienteId], references: [id])
  createdAt  DateTime @default(now())
  turno      Turno?
}


model Turno {
  id             String    @id @default(uuid())
  latitudPuesto  Float
  longitudPuesto Float
  horaInicio     DateTime
  horaFinEstimada DateTime // <-- NUEVO: Heredado de la solicitud
  horaFin        DateTime? 
  horasEfectivas Float?    
  estado         String    @default("Pendiente") 
  
  vigilanteId    String
  vigilante      Usuario   @relation(fields: [vigilanteId], references: [id])
  solicitudId    String?    @unique
  solicitud      Solicitud? @relation(fields: [solicitudId], references: [id])
  createdAt      DateTime  @default(now())
}